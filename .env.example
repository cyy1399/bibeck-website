# PostgreSQL connection string. Use a pooled, TLS-enabled production URL.
DATABASE_URL=
APP_URL=https://www.bibeck.com

# Keep false until database migration, OAuth, Email and Turnstile are verified.
REBATE_ACTIVATION_ENABLED=false

# Existing Resend-compatible Email provider.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=BiBeck <hello@bibeck.com>
REBATE_ADMIN_EMAIL=admin@bibeck.com
SUPPORT_EMAIL=support@bibeck.com
APPLICATION_EMAIL_TO=support@bibeck.com

# Auth.js Google OAuth. Use hello@bibeck.com for login, not the admin alias.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL_ALLOWLIST=hello@bibeck.com

# Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public rebate application and independent third-party dashboard URLs.
NEXT_PUBLIC_BIBECK_REBATE_APPLICATION_URL=https://docs.google.com/forms/d/e/1FAIpQLScPAwgBuIVlaJ_0dM5JXF1_QhEgCwygM9PBZRFItiQF6AQ74Q/viewform?usp=dialog
NEXT_PUBLIC_REBATE_BACKOFFICE_URL=https://bybackoffice.com/user-login
